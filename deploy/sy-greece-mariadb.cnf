[mysqld]
user = mysql
datadir = /www/server/data/sy-greece-mariadb
port = 3307
bind-address = 127.0.0.1
socket = /www/server/data/sy-greece-mariadb/mysql.sock
pid-file = /www/server/data/sy-greece-mariadb/mariadb.pid
log-error = /www/server/data/sy-greece-mariadb/mariadb.log
skip-name-resolve
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
default_storage_engine = InnoDB
max_connections = 50
innodb_buffer_pool_size = 128M
innodb_file_per_table = 1

[client]
port = 3307
socket = /www/server/data/sy-greece-mariadb/mysql.sock
default-character-set = utf8mb4
